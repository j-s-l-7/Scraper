data/raw/
data/documents/
logs/
*.log

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Supabase CLI scratch
supabase/.temp/

# Local indexes, state and build output (never commit)
data/*.sqlite
data/*.sqlite-*
data/.collected_runs
data/.refresh.lock
data/.no-autosync
data/lake/
reports/
console/web/node_modules/
console/web/.next/
console/web/out/
